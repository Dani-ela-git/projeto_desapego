# Porta do servidor
PORT=3000

# String de conexão com o MongoDB (local)
MONGODB_URI=mongodb://localhost:27017/projeto_desapego

# Chave secreta para JWT (pode gerar uma string aleatória)
JWT_SECRET=sua_chave_secreta_aqui

# Google Maps API (necessário para geocoding)
GOOGLE_MAPS_API_KEY=sua_chave_do_google_maps